# Base URL used for canonical links, Open Graph, and sitemap generation.
# In production this should be your deployed domain, e.g. https://emberandoak.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store display name, used in metadata templates and structured data.
NEXT_PUBLIC_STORE_NAME="Ember & Oak"

# Optional: a privacy-conscious analytics provider (e.g. Plausible, Fathom, Vercel Analytics).
# Leave blank to disable analytics entirely. See README "Analytics" section.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Optional: enable Vercel Speed Insights / Web Vitals reporting endpoint.
NEXT_PUBLIC_ENABLE_WEB_VITALS=true

# Checkout is simulated in this demo (no real payment processor is called).
# Provide these to wire up a real provider later, e.g. Stripe:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
